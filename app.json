{
  "expo": {
    "name": "Revloguum",
    "slug": "Revloguum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/image.svg",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.veruum.Revloguum"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/image.svg",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.veruum.Revloguum"
    },
    "web": {
      "favicon": "./assets/image.svg"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "packagingOptions": {
              "pickFirst": ["**/libcrypto.so"]
            }
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Revloguum uses your photos to add vehicle images and service records.",
          "cameraPermission": "Revloguum uses your camera to take vehicle photos and service photos."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "51f3acc6-6842-40b5-a2bb-0c6618cf7963"
      }
    },
    "owner": "veruum_"
  }
}
