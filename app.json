{
  "expo": {
    "name": "Revloguum",
    "slug": "Revloguum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/image.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.veruum.Revloguum"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/image.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.veruum.Revloguum"
    },
    "web": {
      "favicon": "./assets/image.png"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "packagingOptions": {
              "pickFirst": [
                "**/libcrypto.so"
              ]
            }
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Revloguum uses selected photos for vehicle images, service records, and document pages.",
          "cameraPermission": "Revloguum uses your camera to photograph service records and document pages."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A84FF"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "51f3acc6-6842-40b5-a2bb-0c6618cf7963"
      }
    },
    "owner": "veruum_"
  }
}
